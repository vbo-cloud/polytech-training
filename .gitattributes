# Git hooks and shell scripts must keep LF endings. Checked out with CRLF under
# Windows (core.autocrlf=true), the shebang reads as "bash\r" — no such program —
# and Git silently skips the hook instead of reporting an error.
.githooks/** text eol=lf
*.sh text eol=lf

# Same reasoning, pre-emptively: CRLF is harmless in today's Dockerfiles but bites
# on the first RUN line continuation, heredoc or entrypoint script.
Dockerfile* text eol=lf
.dockerignore text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
